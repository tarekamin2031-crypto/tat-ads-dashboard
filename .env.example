# Meta System User token with ads_read permission
META_ACCESS_TOKEN=
# Local file for dev, or a Turso URL (libsql://...) in production
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
# Password for /admin (HTTP basic auth, any username)
DASHBOARD_PASSWORD=
# Random string used to sign client login cookies (openssl rand -hex 32)
SESSION_SECRET=
