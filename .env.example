# Meta System User token with ads_read permission
META_ACCESS_TOKEN=
# Local file for dev, or a Turso URL (libsql://...) in production
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
# First password for /admin (email below). After the first sign-in you change it from "My account" and this is ignored.
DASHBOARD_PASSWORD=
ADMIN_EMAIL=tarekamin2031@gmail.com
# Random string used to sign client login cookies (openssl rand -hex 32)
SESSION_SECRET=
# TikTok Marketing API token (optional, enables TikTok data)
TIKTOK_ACCESS_TOKEN=
